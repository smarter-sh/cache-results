# -----------------------------------------------------------------------------
# written by: Lawrence McDaniel
#             https://lawrencemcdaniel.com
#
# usage:      additional global version constraints.
#             -r constraints.in
#
#             The lower bounds of the package's own dependencies are the ones
#             that pyproject.toml publishes. Keep the two the same.
# -----------------------------------------------------------------------------
Django>=4.2                         # the oldest Django that cache-results supports (pyproject.toml)
asgiref>=3.6                        # sync_to_async(thread_sensitive=False), and Django 4.2's own minimum
django-redis>=5.4                   # the oldest django-redis that the redis extra supports
pip-tools>=7.6.1                    # 7.5.x is incompatible with pip 26.2+ (stdlib_pkgs was removed)
